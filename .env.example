# ============================================================================
# daily-xi environment — copy to .env and fill in.
# Values here are BAKED INTO THE CLIENT BUNDLE at build time (restart the dev
# server / rebuild after changes). Never put server-side secrets in this file.
# ============================================================================

# Supabase project (Settings → API). Anon key only — the service role key
# NEVER ships in the app; it lives in Supabase Vault + function secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Shared signup secret for the friends league (speed bump, not security —
# it is visible in the bundle).
INVITE_CODE=choose-a-code

# Web Push: PUBLIC half of the VAPID pair (generate: npx web-push generate-vapid-keys).
# Optional — web push is disabled when unset.
EXPO_PUBLIC_VAPID_KEY=

# Sentry crash reporting DSN (free project at sentry.io). Optional — reporting
# is disabled when unset.
EXPO_PUBLIC_SENTRY_DSN=

# KLIPY GIF API key for chat GIFs (klipy.com partner panel → app key; a test key
# allows ~100 req/hr). Passed as a URL path segment; visible in the bundle like
# INVITE_CODE, so restrict it in the panel. Optional — the GIF button is hidden
# when unset.
EXPO_PUBLIC_KLIPY_KEY=

# Apple Developer Team ID — signs the app + the Live Activity widget extension
# (Apple Developer portal → Membership). Build-time only (not bundled at
# runtime); EAS-managed signing is used if unset.
APPLE_TEAM_ID=

# ============================================================================
# SERVER-SIDE secrets — NOT in this file. Set as Supabase function secrets
# (`supabase secrets set K=V`; locally in supabase/functions/.env):
#   APNS_KEY_ID         Live Activity APNs Auth Key (.p8) Key ID  [Phase 7]
#   APNS_TEAM_ID        Apple Team ID (APNs)                      [Phase 7]
#   APNS_AUTH_KEY       the .p8 PEM contents                      [Phase 7]
#   APNS_TOPIC          app bundle id (com.novem.startingxi)      [Phase 7]
#   OPENAI_API_KEY      scout-card generation (gpt-4o-mini)
#   SCOUT_MODEL         optional model override (default gpt-4o-mini)
#   VAPID_PRIVATE_KEY   Web Push signing (pair of EXPO_PUBLIC_VAPID_KEY)
#   VAPID_SUBJECT       mailto:you@example.com
# And in Supabase Vault (SQL editor, for pg_cron jobs):
#   edge_base_url       https://<ref>.supabase.co/functions/v1
#   service_role_key    the service role key
# ============================================================================
